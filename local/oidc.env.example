# Enterprise SSO (Microsoft Entra / any OIDC IdP) for the local dev stack.
# Copy this file to `oidc.env` and fill in real values. `oidc.env` is gitignored — never
# commit real secrets. The backend service loads it via `env_file` (optional: if absent,
# enterprise SSO simply stays off).
#
# The redirect URI registered in Entra must match WIAB_BASE_URL exactly, i.e.
#   http://localhost:3000/api/auth/oidc/enterprise/callback

WIAB_AUTH_OIDC_ENABLED=true
# Issuer = https://login.microsoftonline.com/<Directory (tenant) ID>/v2.0
WIAB_OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
WIAB_OIDC_CLIENT_ID=<application-client-id>
WIAB_OIDC_CLIENT_SECRET=<client-secret-value>

# Optional: pre-provision a dev user as Active + Owner of O-1, so a real SSO login matches
# an existing account instead of a role-less JIT one. Match EMAIL to the IdP's UPN exactly.
# Idempotent and a no-op unless WIAB_DEV_SSO_OWNER_EMAIL is set. PASSWORD is a local fallback.
WIAB_DEV_SSO_OWNER_EMAIL=<your-upn@example.com>
WIAB_DEV_SSO_OWNER_NAME=<Your Name>
WIAB_DEV_SSO_OWNER_PASSWORD=<local-fallback-password>

# Google social login. Register an OAuth client in Google Cloud with redirect URI
#   http://localhost:3000/api/auth/oidc/google/callback
# then set these and flip ENABLED to true. Leave disabled until you have a client.
WIAB_AUTH_GOOGLE_ENABLED=false
WIAB_GOOGLE_CLIENT_ID=<google-oauth-client-id>
WIAB_GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>

# Email delivery. Default provider is Resend (HTTP API). Set a key and a from-address on a
# domain verified in Resend (or onboarding@resend.dev for testing — delivers only to your own
# Resend account address). For local SMTP/Mailpit instead, set WIAB_EMAIL_PROVIDER=smtp.
RESEND_API_KEY=<resend-api-key>
WIAB_EMAIL_FROM=onboarding@resend.dev
